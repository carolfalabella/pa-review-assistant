# Copy this file to .env and fill in your own values. Never commit .env.
# SYNTHETIC DATA ONLY: never send real patient data to a free-tier API.

# Which model provider to use: gemini | ollama | saved
PROVIDER=gemini

# Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Leave blank to use the model's default temperature.
GEMINI_TEMPERATURE=
# Seconds to wait before each retry of a busy (429/5xx) response. On a 429,
# the code waits at least as long as Google's "retry after" hint (up to 90s).
# Free tier for gemini-3.6-flash on Nov 7, 2026: 5 requests/minute, 250K tokens/minute.
RETRY_WAITS=5,10,20,40
REQUEST_TIMEOUT=180

# Local fallback through Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# false = turn off thinking mode (faster). Leave blank to not send the setting.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=16384

# Saved-run fallback: path to a file in runs/saved/ (used when PROVIDER=saved)
SAVED_RUN=

# Optional: fixed receipt time for the deadline clock, e.g. 2026-11-16T09:00:00-05:00
# Blank = the moment the packet is loaded.
DEMO_RECEIPT_TIME=
